generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int       @id @default(autoincrement())
  tcNo        String    @unique
  fullName    String
  title       String?
  birthDate   DateTime?
  homeAddress String?
  workAddress String?
  gsm         String?
  phone       String?
  fax         String?
  email       String    @unique
  otherEmail  String?
  url         String?
  password    String?
  role        String    @default("user") // "user" veya "admin"
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  awards                    Award[]
  peerReviews               PeerReview[]
  theses                    Thesis[]
  supervisedTheses          SupervisedThesis[]
  educations                Education[]
  academicDuties            AcademicDuty[]
  scientificDuties          ScientificDuty[]
  administrativeDuties      AdministrativeDuty[]
  publications              Publication[]
  citations                 Citation[]
  books                     Book[]
  foreignLanguages          ForeignLanguage[]
  internationalExperiences  InternationalExperience[]
  certificates              Certificate[]
  projects                  Project[]
  patents                   Patent[]
  designs                   Design[]
  scientificMeetings        ScientificMeeting[]
  organizationMemberships   OrganizationMembership[]
  artisticActivities        ArtisticActivity[]
  postdoctoralResearches    PostdoctoralResearch[]
  visitingResearches        VisitingResearch[]
  yoksisResearches          YoksisResearch[]
  announcements             Announcement[]
}

model Award {
  id        Int      @id @default(autoincrement())
  name      String
  year      String
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PeerReview {
  id        Int      @id @default(autoincrement())
  name      String
  year      String
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Thesis {
  id                 Int      @id @default(autoincrement())
  sectionId          String?
  advisorCount       String?  @default("1")
  advisorName        String?
  advisorMidName     String?
  advisorSurname     String?
  coAdvisorName      String?
  coAdvisorMidName   String?
  coAdvisorSurname   String?
  university         String?
  universityOther    String?
  institute          String?
  instituteOther     String?
  department         String?
  departmentOther    String?
  title              String
  titleEn            String?
  abstract           String?
  abstractEn         String?
  pageCount          String?
  status             String?  @default("0") // 0=Devam Ediyor, 1=Tamamlandı
  keywords           String?  // JSON string: [["tr1","en1"],["tr2","en2"],...]
  file               String?
  url                String?
  city               String?
  country            String?
  date               String
  userId             Int
  user               User     @relation(fields: [userId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model SupervisedThesis {
  id              Int      @id @default(autoincrement())
  department      String?
  studentName     String?
  title           String
  titleEn         String?
  thesisType      String?  // Yüksek Lisans, Doktora, etc.
  status          String?  @default("0") // 0=Devam Ediyor, 1=Tamamlandı
  file            String?
  date            String
  userId          Int
  user            User     @relation(fields: [userId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Education {
  id          Int      @id @default(autoincrement())
  degree      String?  // Lisans, Yüksek Lisans, Doktora, vb.
  department  String?  // Bölüm
  university  String?  // Üniversite/Kurum
  faculty     String?  // Fakülte/Enstitü
  title       String   // Genel başlık (geriye dönük uyumluluk)
  date        String   // Yıl
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AcademicDuty {
  id          Int      @id @default(autoincrement())
  titleTr     String?  // Türkçe Ünvan
  titleEn     String?  // İngilizce Ünvan
  institution String?  // Kurum
  faculty     String?  // Fakülte/Enstitü
  title       String   // geriye dönük uyumluluk
  date        String
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ScientificDuty {
  id               Int      @id @default(autoincrement())
  role             String?  // Görev
  organizationName String?  // Organizasyon/Kitap/Dergi Adı
  titleTr          String?
  titleEn          String?
  institution      String?
  faculty          String?
  title            String
  date             String
  userId           Int
  user             User     @relation(fields: [userId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AdministrativeDuty {
  id           Int      @id @default(autoincrement())
  titleTr      String?  // Görev Ünvan (Türkçe)
  titleEn      String?  // Görev Ünvan (İngilizce)
  role         String?  // Görev
  institution  String?  // Kurum/Diğer
  faculty      String?
  title        String
  date         String
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Publication {
  id          Int      @id @default(autoincrement())
  department  String?  // Bölüm
  title       String   // Başlık
  journalName String?  // Dergi Adı
  volume      String?  // Cilt
  year        String?  // Yıl
  date        String
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Citation {
  id                      Int      @id @default(autoincrement())
  sourceType              String?  // publication, book, thesis, bildiri, sanatsal, proje, patent, tasarim
  sourceId                Int?     // ilgili kaydın ID'si
  sourceTitle             String?  // kaynak başlığı (denormalized)
  sourceYear              String?  // kaynak yılı
  citationYear            String?  // atıf yılı (örn. 2025)
  ssci                    Int?     @default(0)
  alanEndeksleri          Int?     @default(0)
  ulakbim                 Int?     @default(0)
  digerUluslararasi       Int?     @default(0)
  uluslararasiKitap       Int?     @default(0)
  ulusalKitap             Int?     @default(0)
  guzelSanatlarUluslararasi Int?   @default(0)
  guzelSanatlarUlusal     Int?     @default(0)
  title                   String   // backward compat
  date                    String   // backward compat
  userId                  Int
  user                    User     @relation(fields: [userId], references: [id])
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model Book {
  id        Int      @id @default(autoincrement())
  title     String
  date      String
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ForeignLanguage {
  id        Int      @id @default(autoincrement())
  language  String   // Dil Adı
  year      String?  // Yıl
  level     String   // Seviyesi
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InternationalExperience {
  id          Int      @id @default(autoincrement())
  content     String?  // Serbest metin (wysihtml5 editör içeriği)
  institution String?  // Kurum (opsiyonel yapılandırılmış alan)
  country     String?  // Ülke
  date        String   // Tarih
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Certificate {
  id             Int      @id @default(autoincrement())
  documentType   String?  // Belge Türü / Kurum
  description    String?  // Belge Tanımı
  title          String   // backward compat
  date           String
  userId         Int
  user           User     @relation(fields: [userId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Project {
  id                   Int      @id @default(autoincrement())
  projectNo            String?  // Proje No
  title                String   // Proje Başlığı
  supportingInstitution String? // Destekleyen Kurum
  status               String   @default("Devam Ediyor")
  date                 String
  userId               Int
  user                 User     @relation(fields: [userId], references: [id])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Patent {
  id        Int      @id @default(autoincrement())
  title     String
  number    String
  date      String
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Design {
  id        Int      @id @default(autoincrement())
  title     String
  date      String
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ScientificMeeting {
  id          Int      @id @default(autoincrement())
  title       String   // Başlık (bildiri/sunum başlığı)
  meetingName String?  // Toplantı Adı
  date        String
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OrganizationMembership {
  id           Int      @id @default(autoincrement())
  organization String
  date         String
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ArtisticActivity {
  id        Int      @id @default(autoincrement())
  title     String
  date      String
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PostdoctoralResearch {
  id          Int      @id @default(autoincrement())
  title       String
  institution String
  date        String
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VisitingResearch {
  id          Int      @id @default(autoincrement())
  title       String
  institution String
  date        String
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model YoksisResearch {
  id        Int      @id @default(autoincrement())
  title     String
  date      String
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String
  date      String
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
