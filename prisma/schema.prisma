generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int       @id @default(autoincrement())
  tcNo        String    @unique
  fullName    String
  title       String?
  birthDate   DateTime?
  homeAddress String?
  workAddress String?
  gsm         String?
  email       String    @unique
  otherEmail  String?
  url         String?
  password    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  awards                    Award[]
  peerReviews               PeerReview[]
  theses                    Thesis[]
  supervisedTheses          SupervisedThesis[]
  educations                Education[]
  academicDuties            AcademicDuty[]
  scientificDuties          ScientificDuty[]
  administrativeDuties      AdministrativeDuty[]
  publications              Publication[]
  citations                 Citation[]
  books                     Book[]
  foreignLanguages          ForeignLanguage[]
  internationalExperiences  InternationalExperience[]
  certificates              Certificate[]
  projects                  Project[]
  patents                   Patent[]
  designs                   Design[]
  scientificMeetings        ScientificMeeting[]
  organizationMemberships   OrganizationMembership[]
  artisticActivities        ArtisticActivity[]
  postdoctoralResearches    PostdoctoralResearch[]
  visitingResearches        VisitingResearch[]
  yoksisResearches          YoksisResearch[]
  announcements             Announcement[]
}

model Award {
  id        Int      @id @default(autoincrement())
  name      String
  year      String
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PeerReview {
  id        Int      @id @default(autoincrement())
