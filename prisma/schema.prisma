generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int       @id @default(autoincrement())
  tcNo        String    @unique
  fullName    String
  title       String?
  birthDate   DateTime?
  homeAddress String?
  workAddress String?
  gsm         String?
  phone       String?
  fax         String?
  email       String    @unique
  otherEmail  String?
  url         String?
  password    String?
  role        String    @default("user") // "user" veya "admin"
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  awards                    Award[]
  peerReviews               PeerReview[]
  theses                    Thesis[]
  supervisedTheses          SupervisedThesis[]
  educations                Education[]
  academicDuties            AcademicDuty[]
  scientificDuties          ScientificDuty[]
  administrativeDuties      AdministrativeDuty[]
  publications              Publication[]
  citations                 Citation[]
  books                     Book[]
  foreignLanguages          ForeignLanguage[]
  internationalExperiences  InternationalExperience[]
  certificates              Certificate[]
  projects                  Project[]
  patents                   Patent[]
  designs                   Design[]
  scientificMeetings        ScientificMeeting[]
  organizationMemberships   OrganizationMembership[]
  artisticActivities        ArtisticActivity[]
  postdoctoralResearches    PostdoctoralResearch[]
  visitingResearches        VisitingResearch[]
  yoksisResearches          YoksisResearch[]
  announcements             Announcement[]
}

model Award {
  id        Int      @id @default(autoincrement())
  name      String
  year      String
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PeerReview {
  id        Int      @id @default(autoincrement())
  name      String
  year      String
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Thesis {
  id                 Int      @id @default(autoincrement())
  sectionId          String?
  advisorCount       String?  @default("1")
  advisorName        String?
  advisorMidName     String?
  advisorSurname     String?
  coAdvisorName      String?
  coAdvisorMidName   String?
  coAdvisorSurname   String?
  university         String?
  universityOther    String?
  institute          String?
  instituteOther     String?
  department         String?
  departmentOther    String?
  title              String
  titleEn            String?
  abstract           String?
  abstractEn         String?
  pageCount          String?
  status             String?  @default("0") // 0=Devam Ediyor, 1=Tamamlandı
  keywords           String?  // JSON string: [["tr1","en1"],["tr2","en2"],...]
  file               String?
  url                String?
  city               String?
  country            String?
  date               String
  userId             Int
  user               User     @relation(fields: [userId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model SupervisedThesis {
  id              Int      @id @default(autoincrement())
  department      String?
  studentName     String?
  title           String
  titleEn         String?
  thesisType      String?  // Yüksek Lisans, Doktora, etc.
  status          String?  @default("0") // 0=Devam Ediyor, 1=Tamamlandı
  file            String?
  date            String
  userId          Int
  user            User     @relation(fields: [userId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Education {
  id          Int      @id @default(autoincrement())
  degree      String?  // Lisans, Yüksek Lisans, Doktora, vb.
  department  String?  // Bölüm
  university  String?  // Üniversite/Kurum
  faculty     String?  // Fakülte/Enstitü
  title       String   // Genel başlık (geriye dönük uyumluluk)
  date        String   // Yıl
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AcademicDuty {
  id          Int      @id @default(autoincrement())
  titleTr     String?  // Türkçe Ünvan
  titleEn     String?  // İngilizce Ünvan
  institution String?  // Kurum
  faculty     String?  // Fakülte/Enstitü
  title       String   // geriye dönük uyumluluk
  date        String
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

